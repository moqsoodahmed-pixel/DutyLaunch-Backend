# Copy this file to .env and fill in real values. Never commit .env.
# This file lists every variable the backend reads — see config/env.js for
# which ones are required vs optional, and where defaults apply.

# --- Core ---
NODE_ENV=development
PORT=8080
HOST=localhost
CLIENT_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8080

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/dutylaunch

# --- Auth ---
JWT_SECRET=replace_with_a_random_string_at_least_32_characters_long
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=dl_token

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=100

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOW_MOCK_PAYMENTS=false

# --- Pricing ---
GST_PRICING=exclusive
GST_RATE=18
TEMPLATE_PRICE=199

# --- Email (Gmail SMTP) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM="DutyLaunch <no-reply@dutylaunch.in>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- AI providers (only set the ones you use) ---
AI_PROVIDER=groq
AI_TIMEOUT_MS=30000
AI_OPTIMIZE_BUDGET_MS=
AI_OPTIMIZE_TOTAL_MS=
PROVIDER_COOLDOWN_MS=
SLOW_PROVIDER_COOLDOWN_MS=
REWRITE_RETRY_DELAY_MS=

GROQ_API_KEY=
GROQ_API_URL=
GROQ_MODEL=
GROQ_MODEL_FALLBACKS=
GROQ_MAX_OUTPUT_TOKENS=

GROK_API_KEY=
GROK_MODEL=
GROK_MODEL_FALLBACKS=
GROK_MAX_OUTPUT_TOKENS=

MISTRAL_API_KEY=
MISTRAL_MODEL=
MISTRAL_MODEL_FALLBACKS=
MISTRAL_MAX_OUTPUT_TOKENS=

GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=
GEMINI_MODEL_FALLBACKS=
GEMINI_MAX_OUTPUT_TOKENS=
GEMINI_THINKING_LEVEL=

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_MODEL_FALLBACKS=
OPENAI_MAX_OUTPUT_TOKENS=
OPENAI_TIMEOUT_MS=

MAGICAL_API_KEY=

# --- Seed script (scripts/seed.js) ---
# Leave unset to have the seed script generate and print a one-time random
# password instead of using a fixed default.
SEED_ADMIN_EMAIL=admin@dutylaunch.com
SEED_ADMIN_PASSWORD=
MOQSOOD_ADMIN_PASSWORD=
