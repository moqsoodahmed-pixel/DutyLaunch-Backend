# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Required ---
MONGODB_URI=mongodb://localhost:27017/dutylaunch
JWT_SECRET=replace_with_a_random_string_at_least_32_characters_long

# --- Server ---
NODE_ENV=development
# PORT must match the Vite dev proxy target in DutyLaunch-Frontend/vite.config.js
PORT=8080
CLIENT_URL=http://localhost:5173

# --- Auth ---
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=dl_token

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300

# --- AI Career Assistant (Groq) ---
# Get a free key at https://console.groq.com/keys (no credit card required).
# Without this set, every other route keeps working — only POST /api/ai/assistant
# will return a clear "not configured yet" error instead of a reply.
GROQ_API_KEY=
# Optional overrides — sane defaults are already baked in if you leave these unset.
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MODEL_FALLBACKS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
